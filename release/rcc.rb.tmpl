class Rcc < Formula
  desc "Restate Cloud operator CLI"
  homepage "https://github.com/restatedev/restate-cloud"
  version "${version}"

  if OS.mac?
    if Hardware::CPU.arm?
      url "https://github.com/restatedev/restate-cloud/releases/download/rcc-v#{version}/rcc-aarch64-apple-darwin.tar.gz"
      sha256 "${darwin_arm64}"
    else
      url "https://github.com/restatedev/restate-cloud/releases/download/rcc-v#{version}/rcc-x86_64-apple-darwin.tar.gz"
      sha256 "${darwin_x86}"
    end
  elsif OS.linux?
    if Hardware::CPU.arm?
      url "https://github.com/restatedev/restate-cloud/releases/download/rcc-v#{version}/rcc-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "${linux_arm64}"
    else
      url "https://github.com/restatedev/restate-cloud/releases/download/rcc-v#{version}/rcc-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "${linux_x86}"
    end
  end

  def install
    bin.install "rcc"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rcc --version")
  end
end
